<?php
declare(strict_types=1);

/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Framework\View\Element\Template $block */

/**
 * Markup only. The component behind `x-data` is registered by
 * `Scr1be_HyvaGraphqlSearch::js/search-register.js`, and everything it needs to know —
 * endpoints, page size, cache TTL, minimum query length — reaches it through the JSON island
 * that `search-scripts.phtml` prints in the head. This template used to carry all of it, plus
 * the component itself, in an inline script that registered no CSP hash.
 */

/** Alpine debounces the keystroke; `search()` still enforces the minimum length server-side of it. */
$debounceMs = 300;
?><div x-data="scr1beInstantSearch"
     @click.outside="close()"
     @keydown.escape.window="close()"
     class="relative w-full max-w-md mx-auto">

    <label class="sr-only" for="scr1be-search-input">
        <?= $escaper->escapeHtml(__('Search products')) ?>
    </label>

    <div class="relative">
        <input id="scr1be-search-input"
               type="search"
               x-model="query"
               @input.debounce.<?= (int) $debounceMs ?>ms="search()"
               @focus="onFocus()"
               @keydown.down.prevent="moveHighlight(1)"
               @keydown.up.prevent="moveHighlight(-1)"
               @keydown.enter.prevent="followHighlight()"
               placeholder="<?= $escaper->escapeHtmlAttr(__('Search products…')) ?>"
               autocomplete="off"
               role="combobox"
               aria-autocomplete="list"
               aria-controls="scr1be-search-results"
               :aria-expanded="isOpen.toString()"
               class="w-full pl-10 pr-10 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500"/>

        <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400"
             viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd"
                  d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l3.817 3.817a1 1 0 01-1.414 1.414l-3.817-3.817A6 6 0 012 8z"
                  clip-rule="evenodd"/>
        </svg>

        <button x-show="query.length > 0"
                @click="reset()"
                type="button"
                class="absolute right-2 top-1/2 -translate-y-1/2 p-1 text-gray-400 hover:text-gray-700"
                aria-label="<?= $escaper->escapeHtmlAttr(__('Clear search')) ?>">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path d="M6 6l8 8M14 6l-8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
        </button>
    </div>

    <div id="scr1be-search-results"
         x-show="isOpen"
         x-cloak
         x-transition.opacity
         class="absolute left-0 right-0 top-full mt-2 bg-white border border-gray-200 rounded shadow-lg max-h-96 overflow-y-auto z-50"
         role="listbox">

        <template x-if="loading">
            <div class="px-4 py-3 text-sm text-gray-500">
                <?= $escaper->escapeHtml(__('Searching…')) ?>
            </div>
        </template>

        <template x-if="!loading && error">
            <div class="px-4 py-3 text-sm text-red-600" x-text="error"></div>
        </template>

        <?php // minQuery, not a literal: Magento's own default for min_query_length is 3, so a
              // hardcoded 2 claimed "no products match" for a query search() never ran. ?>
        <template x-if="!loading && !error && results.length === 0 && query.length >= minQuery">
            <div class="px-4 py-3 text-sm text-gray-500">
                <?= $escaper->escapeHtml(__('No products match your search.')) ?>
            </div>
        </template>

        <template x-for="(item, index) in results" :key="item.uid">
            <a :href="productUrl(item)"
               @mouseenter="highlightIndex = index"
               :class="highlightIndex === index && 'bg-blue-50'"
               class="flex items-center gap-3 px-4 py-2 hover:bg-blue-50"
               role="option"
               :aria-selected="(highlightIndex === index).toString()">
                <img :src="item.small_image.url" :alt="item.small_image.label" class="w-10 h-10 object-cover rounded" loading="lazy"/>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-medium truncate" x-html="highlightMatch(item.name)"></p>
                    <p class="text-xs text-gray-500" x-text="formatPrice(item)"></p>
                </div>
            </a>
        </template>

        <template x-if="!loading && totalCount > results.length">
            <a :href="seeAllUrl()"
               class="block px-4 py-2 text-sm font-medium text-center text-blue-600 bg-gray-50 hover:bg-gray-100">
                <?= $escaper->escapeHtml(__('See all results')) ?>
                <span x-text="`(${totalCount})`"></span>
            </a>
        </template>
    </div>
</div>
