{
    "name": "scr1be/back-in-stock",
    "description": "Turns Magento's passive back-in-stock alert into an active re-engagement surface — one extra column on the core alert table, a customer-data section, a Hyva popup with inline and bulk add-to-cart, a My Product Alerts page, a GraphQL query and an optional FCM push channel behind a transport interface",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-inventory": "^100.4",
        "magento/module-product-alert": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-review": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-config": "^101.2",
        "magento/module-backend": "^102.0",
        "magento/module-checkout": "^100.4",
        "magento/module-graph-ql": "^100.4",
        "magento/module-customer-graph-ql": "^100.4",
        "magento/module-store-graph-ql": "^100.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\BackInStock\\": ""
        }
    }
}
