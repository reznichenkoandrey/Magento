<?xml version="1.0"?>
<!--
  Two schema changes, and they are deliberately of different kinds.

  `product_alert_stock` is Magento_ProductAlert's table. Re-declaring it here adds one column to it
  instead of shadowing it: declarative schema merges every module's declaration of a table name into
  one definition, so this file contributes `popup_status` and the index that reads it, and nothing
  else. Dropping this module drops the column and leaves core's table intact.

  `scr1be_push_device_token` is this module's own table, because a device token is not an alert. It
  outlives any single alert, it belongs to a browser or an app install rather than to a customer row,
  and it has to be writable by a guest.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="product_alert_stock" resource="default" engine="innodb" comment="Product Alert Stock">
        <column xsi:type="smallint" name="popup_status" unsigned="true" nullable="false" identity="false"
                default="0" comment="Back-in-stock popup state: 0 idle, 1 queued, 2 shown"/>
        <!--
          The provider's only query is (customer_id, website_id, popup_status) with popup_status
          pinned to one value, so those three columns in that order make it a covering index scan on
          a table whose core indexes are all single-column.
        -->
        <index referenceId="SCR1BE_BACK_IN_STOCK_CUSTOMER_ID_WEBSITE_ID_POPUP_STATUS" indexType="btree">
            <column name="customer_id"/>
            <column name="website_id"/>
            <column name="popup_status"/>
        </index>
    </table>
    <table name="scr1be_push_device_token" resource="default" engine="innodb"
           comment="Push notification device tokens">
        <column xsi:type="int" name="token_id" unsigned="true" nullable="false" identity="true"
                comment="Device token ID"/>
        <!--
          The hash is the identity, not the token. A push token is long (FCM tokens run past 160
          characters and the vendors reserve the right to grow them), it arrives from an untrusted
          client, and it is the only value in this table worth stealing. Hashing it gives a
          fixed-width unique key that upserts cleanly, and keeps the index out of the part of the row
          that is a secret.
        -->
        <column xsi:type="varchar" name="token_hash" length="64" nullable="false"
                comment="SHA-256 of the device token"/>
        <column xsi:type="text" name="token" nullable="false" comment="Device token"/>
        <!--
          Nullable on purpose: a visitor can arm a browser for notifications before creating an
          account. The token is claimed by a customer id on the first registration that carries one.
        -->
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" identity="false"
                comment="Customer ID, null for a guest device"/>
        <column xsi:type="smallint" name="website_id" unsigned="true" nullable="false" identity="false"
                default="0" comment="Website ID"/>
        <column xsi:type="varchar" name="platform" length="16" nullable="false" default="web"
                comment="Device platform"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false"
                default="1" comment="Whether the token is still deliverable"/>
        <column xsi:type="varchar" name="deactivated_reason" length="64" nullable="true"
                comment="Why the transport stopped trusting this token"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="token_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SCR1BE_PUSH_DEVICE_TOKEN_TOKEN_HASH">
            <column name="token_hash"/>
        </constraint>
        <!--
          SET NULL rather than CASCADE: a deleted account should not take a browser's subscription
          with it, because the browser is still there and may well be logged into another account
          five minutes later. The row degrades to a guest device.
        -->
        <constraint xsi:type="foreign" referenceId="SCR1BE_PUSH_DEVICE_TOKEN_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="scr1be_push_device_token" column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="SET NULL"/>
        <constraint xsi:type="foreign" referenceId="SCR1BE_PUSH_DEVICE_TOKEN_WEBSITE_ID_STORE_WEBSITE_WEBSITE_ID"
                    table="scr1be_push_device_token" column="website_id" referenceTable="store_website"
                    referenceColumn="website_id" onDelete="CASCADE"/>
        <index referenceId="SCR1BE_PUSH_DEVICE_TOKEN_CUSTOMER_ID_WEBSITE_ID_IS_ACTIVE" indexType="btree">
            <column name="customer_id"/>
            <column name="website_id"/>
            <column name="is_active"/>
        </index>
    </table>
</schema>
