<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Scr1be\BackInStock\Block\PopupScripts;

/** @var PopupScripts $block */
/** @var Escaper $escaper */

/**
 * Two tags: the endpoint config, and the entry module that reads it.
 *
 * **There is deliberately no import map.** `popup-register.js` imports `./alert-client.js` and
 * `./popup.js` by relative path, so no bare specifier on this page was ever resolved through one —
 * the map this template used to print bound three specifiers nothing imported. It was not free
 * either: a document installs the first import map it declares and Firefox rejects every one after
 * it, and this block renders from `default.xml`, i.e. on every page, *after* the slider's map
 * (which is ordered `before="-"`). So it was never installed in Firefox to begin with, and it stood
 * ready to swallow the first real bare specifier this module ever added.
 *
 * Nothing inline is emitted, so there is no `HyvaCsp::registerInlineScript()` call:
 * `application/json` is a media type no engine executes and needs no CSP treatment, and the module
 * script is external.
 */

if (!$block->isEnabled()) {
    return;
}
?>
<script type="application/json" data-scr1be-back-in-stock-config>
<?= /* @noEscape */ $block->getConfigJson() ?>
</script>
<script type="module" src="<?= $escaper->escapeUrl($block->getEntryScriptUrl()) ?>"></script>
