<?xml version="1.0"?>
<!--
  `2columns-left` and the `customer_account` handle together are what put the account navigation
  beside this page: the handle brings in `sidebar.main.account_nav`, the layout gives it a column.
  Both are what core's own account pages do.
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="2columns-left"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceContainer name="content">
            <block class="Scr1be\BackInStock\Block\Account\AlertList"
                   name="scr1be.back_in_stock.account.alerts"
                   template="Scr1be_BackInStock::account/alerts.phtml"
                   cacheable="false"/>
        </referenceContainer>
    </body>
</page>
