<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
      The section source is registered here and nowhere else. There is deliberately no
      sections.xml: sections.xml maps *storefront actions* to the sections they invalidate, and
      nothing the shopper does can change this section's answer — the change it reports is made
      by an admin, in a different session, on a different machine. The section rides the reload
      cycle customer-data already has (see the README on how long that takes and why the
      place-order guard exists because of it).
    -->
    <type name="Magento\Customer\CustomerData\SectionPoolInterface">
        <arguments>
            <argument name="sectionSourceMap" xsi:type="array">
                <item name="scr1be_force_logout" xsi:type="string">Scr1be\CustomerGroupGuard\CustomerData\ForceLogout</item>
            </argument>
        </arguments>
    </type>
</config>
