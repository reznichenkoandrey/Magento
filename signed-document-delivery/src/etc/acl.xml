<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Config::config">
                        <!--
                          Its own resource rather than riding on Magento_Config::config. The two
                          settings behind it are the lifetime of a signing credential and the
                          lifetime of a directory of customer paperwork; an admin role that may
                          edit shipping methods has no reason to be able to widen either.
                        -->
                        <resource id="Scr1be_SignedDocumentDelivery::config"
                                  title="Signed Document Delivery Section"
                                  translate="title"
                                  sortOrder="140"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
