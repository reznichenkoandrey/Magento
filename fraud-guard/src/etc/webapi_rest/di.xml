<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
      Without this, GET /V1/customers/me hands a flagged carder the flag in custom_attributes.
      Area scoped so the adminhtml customer form keeps the metadata it needs in order to save.
    -->
    <type name="Magento\Customer\Api\CustomerMetadataInterface">
        <plugin name="scr1be_fraud_guard_hide_flag_from_api"
                type="Scr1be\FraudGuard\Plugin\Customer\HideFlagFromApiMetadata"
                sortOrder="10"/>
    </type>
</config>
