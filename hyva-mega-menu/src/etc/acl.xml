<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <!--
                              Its own resource rather than riding on Magento_Config::config: the
                              group map decides which catalogue a signed-in shopper is shown, so
                              it is closer to a merchandising permission than to a settings one.
                              A merchant should be able to hand out configuration access without
                              handing out the ability to point Wholesale at a different tree.
                            -->
                            <resource id="Scr1be_HyvaMegaMenu::config"
                                      title="Mega Menu"
                                      sortOrder="130"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
