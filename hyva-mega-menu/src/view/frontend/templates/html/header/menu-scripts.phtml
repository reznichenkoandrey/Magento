<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Scr1be\HyvaMegaMenu\Block\MenuScripts;

/** @var MenuScripts $block */
/** @var Escaper $escaper */

/**
 * One tag, and no import map behind it.
 *
 * The map this template used to print was one of three on the page — this module's, the product
 * card's and the slider's. Firefox installs the first import map a document declares and rejects
 * every one after it, so two of the three were being dropped and the modules behind them never
 * booted. The entry module now imports its siblings relatively, which needs no map.
 *
 * Nothing inline is emitted any more, so there is no `HyvaCsp::registerInlineScript()` call either:
 * it acts on the last script in the output buffer, and the only script here is an external one that
 * `script-src` covers by origin.
 */
?>
<script type="module" src="<?= $escaper->escapeUrl($block->getEntryScriptUrl()) ?>"></script>
