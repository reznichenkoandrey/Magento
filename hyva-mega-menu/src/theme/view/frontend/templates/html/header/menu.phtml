<?php
declare(strict_types=1);

use Magento\Framework\Data\Tree\Node;
use Scr1be\MegaMenuAttributes\ViewModel\CategoryFeaturedImage;

/** @var \Magento\Theme\Block\Html\Topmenu $block */
/** @var \Magento\Framework\Escaper $escaper */

$root = $block->getMenu();
$level1 = $root->getChildren();
$columnCount = (int) $block->getViewConfig()->getVarValue('Scr1be_MegaMenu', 'column_count') ?: 4;

/** @var CategoryFeaturedImage|null $featuredVm */
$featuredVm = $block->getData('featured_image_view_model');
?>
<nav x-data="initMegaMenu"
     @keydown.escape.window="close()"
     @click.outside="close()"
     class="relative bg-white border-b border-gray-200"
     aria-label="<?= $escaper->escapeHtmlAttr(__('Main navigation')) ?>">

    <button type="button"
            @click="mobileOpen = !mobileOpen"
            class="md:hidden inline-flex items-center px-4 py-3"
            :aria-expanded="mobileOpen.toString()"
            aria-controls="mega-mobile-drawer">
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <span class="ml-2"><?= $escaper->escapeHtml(__('Menu')) ?></span>
    </button>

    <ul class="hidden md:flex">
        <?php /** @var Node $node */ foreach ($level1 as $node): ?>
            <?php
            $nodeId = 'mega-' . (int) $node->getId();
            $hasChildren = $node->hasChildren();
            $featuredImageUrl = $featuredVm?->getFeaturedImageUrl((int) $node->getId());
            ?>
            <li class="relative"
                @mouseenter="<?= $hasChildren ? "open('{$nodeId}')" : '' ?>">
                <a href="<?= $escaper->escapeUrl($node->getUrl()) ?>"
                   class="inline-flex items-center px-4 py-4 text-sm font-medium hover:text-blue-600"
                   <?php if ($hasChildren): ?>
                       @click.prevent="toggle('<?= $escaper->escapeJs($nodeId) ?>')"
                       :aria-expanded="(activePanel === '<?= $escaper->escapeJs($nodeId) ?>').toString()"
                       aria-haspopup="true"
                   <?php endif; ?>>
                    <?= $escaper->escapeHtml($node->getName()) ?>
                </a>
                <?php if ($hasChildren): ?>
                    <div x-show="activePanel === '<?= $escaper->escapeJs($nodeId) ?>'"
                         x-transition.opacity
                         x-cloak
                         class="absolute left-0 top-full z-40 w-screen max-w-5xl bg-white shadow-xl border border-gray-200 p-6">
                        <div class="grid gap-6"
                             style="grid-template-columns: repeat(<?= (int) $columnCount ?>, minmax(0, 1fr));">
                            <?php
                            $reservedForImage = $featuredImageUrl ? 1 : 0;
                            $maxSubcolumns = $columnCount - $reservedForImage;
                            $i = 0;
                            ?>
                            <?php foreach ($node->getChildren() as $level2): ?>
                                <?php if ($i++ >= $maxSubcolumns) break; ?>
                                <div>
                                    <a href="<?= $escaper->escapeUrl($level2->getUrl()) ?>"
                                       class="block mb-2 font-semibold text-gray-900 hover:text-blue-600">
                                        <?= $escaper->escapeHtml($level2->getName()) ?>
                                    </a>
                                    <?php if ($level2->hasChildren()): ?>
                                        <ul class="space-y-1 text-sm text-gray-700">
                                            <?php foreach ($level2->getChildren() as $level3): ?>
                                                <li>
                                                    <a href="<?= $escaper->escapeUrl($level3->getUrl()) ?>"
                                                       class="hover:text-blue-600">
                                                        <?= $escaper->escapeHtml($level3->getName()) ?>
                                                    </a>
                                                </li>
                                            <?php endforeach; ?>
                                        </ul>
                                    <?php endif; ?>
                                </div>
                            <?php endforeach; ?>

                            <?php if ($featuredImageUrl): ?>
                                <a href="<?= $escaper->escapeUrl($node->getUrl()) ?>"
                                   class="block rounded overflow-hidden bg-gray-100">
                                    <img src="<?= $escaper->escapeUrl($featuredImageUrl) ?>"
                                         alt="<?= $escaper->escapeHtmlAttr($node->getName()) ?>"
                                         class="w-full h-full object-cover"
                                         loading="lazy"/>
                                </a>
                            <?php endif; ?>
                        </div>
                    </div>
                <?php endif; ?>
            </li>
        <?php endforeach; ?>
    </ul>

    <div id="mega-mobile-drawer"
         x-show="mobileOpen"
         x-transition:enter="transition-transform duration-200"
         x-transition:enter-start="-translate-x-full"
         x-transition:enter-end="translate-x-0"
         x-cloak
         class="fixed inset-0 z-50 bg-white md:hidden overflow-y-auto"
         role="dialog"
         aria-modal="true">
        <div class="flex items-center justify-between p-4 border-b">
            <span class="font-semibold"><?= $escaper->escapeHtml(__('Menu')) ?></span>
            <button type="button" @click="mobileOpen = false" aria-label="<?= $escaper->escapeHtmlAttr(__('Close')) ?>">
                <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/>
                </svg>
            </button>
        </div>
        <ul class="divide-y">
            <?php foreach ($level1 as $node): ?>
                <li x-data="{ open: false }">
                    <button type="button"
                            @click="open = !open"
                            class="flex items-center justify-between w-full px-4 py-3 text-left">
                        <span><?= $escaper->escapeHtml($node->getName()) ?></span>
                        <?php if ($node->hasChildren()): ?>
                            <svg class="w-4 h-4 transition-transform" :class="open && 'rotate-180'" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path d="M5 8l5 5 5-5z"/>
                            </svg>
                        <?php endif; ?>
                    </button>
                    <?php if ($node->hasChildren()): ?>
                        <ul x-show="open" x-cloak class="bg-gray-50">
                            <?php foreach ($node->getChildren() as $level2): ?>
                                <li>
                                    <a href="<?= $escaper->escapeUrl($level2->getUrl()) ?>"
                                       class="block px-6 py-2 text-sm">
                                        <?= $escaper->escapeHtml($level2->getName()) ?>
                                    </a>
                                </li>
                            <?php endforeach; ?>
                        </ul>
                    <?php endif; ?>
                </li>
            <?php endforeach; ?>
        </ul>
    </div>
</nav>

<script>
    'use strict';
    function initMegaMenu() {
        return {
            activePanel: null,
            mobileOpen: false,
            open(id) { this.activePanel = id; },
            toggle(id) { this.activePanel = this.activePanel === id ? null : id; },
            close() { this.activePanel = null; this.mobileOpen = false; },
        };
    }

    document.addEventListener('alpine:init', () => {
        Alpine.data('initMegaMenu', initMegaMenu);
    });
</script>
