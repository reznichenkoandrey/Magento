<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="scr1be" translate="label" sortOrder="400">
            <label>scr1be</label>
        </tab>
        <section id="scr1be_wishlist_share" translate="label" type="text" sortOrder="34"
                 showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Headless Suite: Wish List Sharing</label>
            <tab>scr1be</tab>
            <resource>Scr1be_WishlistShare::config</resource>
            <group id="email" translate="label comment" type="text" sortOrder="10"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Email</label>
                <comment><![CDATA[
                    How many addresses one share may name and how long the covering note may be are
                    <em>not</em> here: those come from <em>Customers &rarr; Wish List &rarr; Share
                    Options</em>, so the API and the storefront form cannot disagree.
                ]]></comment>
                <field id="template" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Email template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <comment>
                        Defaults to this module's own template rather than the storefront's, whose
                        item table is rendered by a frontend-area layout block that an API request
                        cannot reach.
                    </comment>
                </field>
                <field id="identity" translate="label" type="select" sortOrder="20"
                       showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Email sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
