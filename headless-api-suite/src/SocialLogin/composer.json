{
    "name": "scr1be/headless-social-login",
    "description": "Sign in with Google or Apple from a native app: an OIDC ID-token verifier over a cached JWKS, a provisioner that resolves (provider, subject) to a customer, its own social-link table, and a mutation returning a Magento customer token with typed error codes.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-curl": "*",
        "magento/framework": "^103.0",
        "magento/module-customer": "^103.0",
        "magento/module-integration": "^100.4",
        "magento/module-authorization": "^100.4",
        "magento/module-store": "^101.1",
        "magento/module-config": "^101.2",
        "magento/module-backend": "^102.0",
        "magento/module-graph-ql": "^100.4",
        "magento/module-store-graph-ql": "^100.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\SocialLogin\\": ""
        }
    }
}
