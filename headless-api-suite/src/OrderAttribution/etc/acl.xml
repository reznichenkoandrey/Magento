<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_other_settings">
                        <!--
                          Editing the registry changes what an app is allowed to send and what every
                          attribution report groups by. It is a merchandising decision, not a
                          configuration toggle, so it gets a resource rather than riding on
                          Magento_Config::config.
                        -->
                        <resource id="Scr1be_OrderAttribution::source"
                                  title="Order Attribution Sources"
                                  translate="title"
                                  sortOrder="100"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
