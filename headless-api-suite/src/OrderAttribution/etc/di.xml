<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Scr1be\OrderAttribution\Api\Data\SourceInterface"
                type="Scr1be\OrderAttribution\Model\Source"/>
    <preference for="Scr1be\OrderAttribution\Api\SourceRepositoryInterface"
                type="Scr1be\OrderAttribution\Model\SourceRepository"/>

    <!--
      The order grid is a denormalised copy, refreshed by Magento\Sales\Model\ResourceModel\Grid from
      the `columns` map on this virtual type. Adding the two columns to the declarative schema puts
      them in the table; adding them here is what actually fills them. Miss this and the grid columns
      render blank on every order and nothing in the logs says why.
    -->
    <virtualType name="Magento\Sales\Model\ResourceModel\Order\Grid" type="Magento\Sales\Model\ResourceModel\Grid">
        <arguments>
            <argument name="columns" xsi:type="array">
                <item name="scr1be_source_code" xsi:type="string">sales_order.scr1be_source_code</item>
                <item name="scr1be_source_detail" xsi:type="string">sales_order.scr1be_source_detail</item>
            </argument>
        </arguments>
    </virtualType>

    <!--
        The grid's data source, registered globally and deliberately not in etc/adminhtml/di.xml
        even though the grid only ever renders there.

        Array arguments merge item by item between modules within one scope, but an area scope is
        applied over the global one as a layer: declaring `collections` in the adminhtml area
        replaces the global list outright instead of adding to it. Doing that here left the
        adminhtml layer holding this one handle and none of the others — not this repo's slider
        grid, and not core's own cms_page_listing_data_source, customer_listing_data_source and
        the rest. Every one of those grids answered "Not registered handle …" with an exception
        behind it, across the whole installation, while the storefront stayed perfectly healthy.

        The virtual type it points at stays in the adminhtml file: a virtual type is a definition,
        not an array element, so the layering does not apply to it.
    -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="scr1be_order_source_listing_data_source" xsi:type="string">Scr1beOrderSourceGridCollection</item>
            </argument>
        </arguments>
    </type>
</config>
