{
    "name": "scr1be/headless-search-autocomplete",
    "description": "One GraphQL query that fans out to products, categories and popular search terms in a single round trip, honouring the admin's autocomplete limit and minimum query length, over a fulltext collection pinned to the quick-search request container.",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-search": "^102.0",
        "magento/module-search": "^101.1",
        "magento/module-store": "^101.1",
        "magento/module-customer": "^103.0",
        "magento/module-graph-ql": "^100.4",
        "magento/module-catalog-graph-ql": "^100.4",
        "magento/module-customer-graph-ql": "^100.4",
        "magento/module-store-graph-ql": "^100.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\SearchAutocomplete\\": ""
        }
    }
}
