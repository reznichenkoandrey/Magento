<?xml version="1.0"?>
<!--
  A registry of its own, plus one column on `quote` and one on `sales_order`.

  The table is deliberately named for this module rather than shared with any other push-capable
  module in the portfolio. Two modules declaring the same table name would merge into one definition
  in declarative schema, which means uninstalling either one drops columns the other still needs, and
  it means their release cycles are coupled forever. A registry is cheap; that coupling is not.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="scr1be_headless_push_device" resource="default" engine="innodb"
           comment="Devices registered for order-lifecycle push notifications">
        <column xsi:type="int" name="device_id" unsigned="true" nullable="false" identity="true"
                comment="Device ID"/>
        <!--
          The hash is the key, not the token. An FCM registration token runs well past 160 characters
          and the vendors reserve the right to lengthen it, so it cannot carry a unique index; a
          sha256 of it can, is fixed width, and upserts cleanly.
        -->
        <column xsi:type="varchar" name="token_hash" length="64" nullable="false"
                comment="SHA-256 of the registration token"/>
        <column xsi:type="text" name="token" nullable="false" comment="FCM registration token"/>
        <!--
          Nullable: a guest can place an order from a freshly installed app. The row is claimed by a
          customer id the first time one is known.
        -->
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="true" identity="false"
                comment="Customer ID, null for a device with no account"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false" identity="false"
                default="0" comment="Store the device registered against, for localised payloads"/>
        <column xsi:type="varchar" name="platform" length="16" nullable="false" default="unknown"
                comment="ios, android or web"/>
        <column xsi:type="smallint" name="is_active" unsigned="true" nullable="false" identity="false"
                default="1" comment="Whether the transport still accepts this token"/>
        <column xsi:type="varchar" name="deactivated_reason" length="64" nullable="true"
                comment="Why the transport stopped accepting it"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Created at"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false"
                default="CURRENT_TIMESTAMP" comment="Updated at"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="device_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="SCR1BE_HEADLESS_PUSH_DEVICE_TOKEN_HASH">
            <column name="token_hash"/>
        </constraint>
        <!--
          SET NULL rather than CASCADE. Deleting an account should not silently unsubscribe a phone
          that is still in somebody's pocket and may well sign into another account five minutes
          later; the row degrades to an unclaimed device.
        -->
        <constraint xsi:type="foreign" referenceId="SCR1BE_HEADLESS_PUSH_DEVICE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="scr1be_headless_push_device" column="customer_id" referenceTable="customer_entity"
                    referenceColumn="entity_id" onDelete="SET NULL"/>
        <index referenceId="SCR1BE_HEADLESS_PUSH_DEVICE_CUSTOMER_ID_IS_ACTIVE" indexType="btree">
            <column name="customer_id"/>
            <column name="is_active"/>
        </index>
    </table>
    <!--
      Two soft-reference columns rather than a join table. The relation is one device per cart and
      one device per order, it is written once and read once, and the value is a hash the registry
      can look up. A foreign key here would also mean a purge of stale device rows could not run
      without touching order history.
    -->
    <table name="quote" resource="checkout" engine="innodb" comment="Sales Flat Quote">
        <column xsi:type="varchar" name="scr1be_device_token_hash" length="64" nullable="true"
                comment="SHA-256 of the device token this cart was built on"/>
    </table>
    <table name="sales_order" resource="sales" engine="innodb" comment="Sales Flat Order">
        <column xsi:type="varchar" name="scr1be_device_token_hash" length="64" nullable="true"
                comment="SHA-256 of the device token this order was placed from"/>
    </table>
</schema>
