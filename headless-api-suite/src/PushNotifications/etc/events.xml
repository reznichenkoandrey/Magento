<?xml version="1.0"?>
<!--
  Global, not area-scoped. The device hash lives on the quote row, so it is present whichever channel
  submits the cart — GraphQL, REST, or a payment gateway callback replaying the quote out of band.
  Scoping this to the graphql area would lose the notification on exactly the flows most likely to
  finish after the app has been closed.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_before">
        <observer name="scr1be_push_carry_device_to_order"
                  instance="Scr1be\PushNotifications\Observer\CarryDeviceToOrder"/>
    </event>
</config>
