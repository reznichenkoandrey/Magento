<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Scr1be_CouponTicket">
        <sequence>
            <module name="Magento_SalesRule"/>
            <module name="Magento_Customer"/>
            <module name="Magento_Widget"/>
            <!--
                Loaded after the engine so this module's di.xml is merged on top of it — which is
                what lets the <item> below be added to a pool the engine declared.
            -->
            <module name="Scr1be_ContentTransfer"/>
        </sequence>
    </module>
</config>
