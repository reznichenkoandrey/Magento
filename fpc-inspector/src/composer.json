{
    "name": "scr1be/fpc-inspector",
    "description": "Full page cache debugging tool for Magento 2 — records what put a non-empty value into the FPC vary string and who forced pragma: no-cache",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-page-cache": "^100.4",
        "magento/module-store": "^101.1"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\FpcInspector\\": ""
        }
    }
}
