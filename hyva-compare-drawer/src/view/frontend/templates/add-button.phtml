<?php
declare(strict_types=1);

use Magento\Framework\Pricing\Helper\Data as PriceHelper;

/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Catalog\Block\Product\AbstractProduct $block */

$product = $block->getProduct();
if (!$product) return;

/** @var PriceHelper $priceHelper */
$priceHelper = \Magento\Framework\App\ObjectManager::getInstance()->get(PriceHelper::class);

$productId = (int) $product->getId();
$payload = [
    'id'    => $productId,
    'name'  => (string) $product->getName(),
    'image' => $block->getImage($product, 'product_small_image')->getImageUrl(),
    'url'   => $product->getProductUrl(),
    'price' => strip_tags((string) $priceHelper->currency($product->getFinalPrice(), true, false)),
];

// JSON output goes inside an HTML attribute, so it has to be HTML-attribute-escaped.
// strip_tags above guarantees `price` contains no markup before encoding.
$payloadJson = $escaper->escapeHtmlAttr(json_encode($payload, JSON_UNESCAPED_SLASHES | JSON_HEX_QUOT | JSON_HEX_APOS));
?>
<button type="button"
        x-data
        :class="$store.compare.has(<?= $productId ?>) && 'ring-2 ring-blue-500'"
        @click="$store.compare.has(<?= $productId ?>) ? $store.compare.remove(<?= $productId ?>) : $store.compare.add(JSON.parse('<?= /* @noEscape */ $payloadJson ?>'))"
        class="inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium border border-gray-300 rounded hover:bg-gray-50"
        :aria-pressed="$store.compare.has(<?= $productId ?>).toString()">
    <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
        <path d="M3 5h4v10H3zM8 3h4v14H8zM13 8h4v7h-4z"/>
    </svg>
    <span x-text="$store.compare.has(<?= $productId ?>) ? '<?= $escaper->escapeJs(__('In compare')) ?>' : '<?= $escaper->escapeJs(__('Compare')) ?>'"></span>
</button>
