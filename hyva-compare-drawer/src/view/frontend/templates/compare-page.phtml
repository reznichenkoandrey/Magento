<?php
declare(strict_types=1);

/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magento\Framework\View\Element\Template $block */

// Canonical: the "continue shopping" target is whatever the storefront's home base URL is.
$continueUrl = $block->getUrl('');
?>
<section x-data class="container mx-auto px-4 py-8">
    <header class="mb-6 flex items-center justify-between">
        <div>
            <h1 class="text-2xl font-bold">
                <?= $escaper->escapeHtml(__('Compare products')) ?>
            </h1>
            <p class="text-sm text-gray-500"
               x-text="`${$store.compare.count} ${$store.compare.count === 1 ? '<?= $escaper->escapeJs(__('product')) ?>' : '<?= $escaper->escapeJs(__('products')) ?>'}`"></p>
        </div>
        <button type="button"
                x-show="$store.compare.count > 0"
                @click="$store.compare.clear()"
                class="text-sm text-red-600 hover:underline">
            <?= $escaper->escapeHtml(__('Clear all')) ?>
        </button>
    </header>

    <template x-if="$store.compare.count === 0">
        <div class="text-center py-16 border border-dashed border-gray-300 rounded-lg">
            <p class="text-gray-600 mb-6">
                <?= $escaper->escapeHtml(__('You have not added any products to compare yet.')) ?>
            </p>
            <a href="<?= $escaper->escapeUrl($continueUrl) ?>"
               class="inline-block px-6 py-3 bg-black text-white text-sm font-medium rounded hover:bg-gray-800">
                <?= $escaper->escapeHtml(__('Continue shopping')) ?>
            </a>
        </div>
    </template>

    <template x-if="$store.compare.count > 0">
        <div class="grid gap-4"
             :style="`grid-template-columns: repeat(${Math.min($store.compare.count, 4)}, minmax(0, 1fr))`">
            <template x-for="item in $store.compare.items" :key="item.id">
                <article class="border border-gray-200 rounded-lg p-4 flex flex-col">
                    <a :href="item.url" class="block mb-3">
                        <img :src="item.image"
                             :alt="item.name"
                             class="w-full h-48 object-cover rounded bg-gray-100"
                             loading="lazy"/>
                    </a>
                    <h2 class="font-semibold mb-2 line-clamp-2">
                        <a :href="item.url" class="hover:underline" x-text="item.name"></a>
                    </h2>
                    <p class="text-lg font-bold mb-4 text-gray-900" x-text="item.price"></p>
                    <div class="mt-auto flex items-center justify-between gap-2">
                        <a :href="item.url"
                           class="flex-1 text-center px-3 py-2 bg-black text-white text-sm font-medium rounded hover:bg-gray-800">
                            <?= $escaper->escapeHtml(__('View')) ?>
                        </a>
                        <button type="button"
                                @click="$store.compare.remove(item.id)"
                                class="px-3 py-2 text-sm text-gray-600 border border-gray-300 rounded hover:bg-gray-50"
                                :aria-label="`<?= $escaper->escapeJs(__('Remove from comparison')) ?>: ${item.name}`">
                            <?= $escaper->escapeHtml(__('Remove')) ?>
                        </button>
                    </div>
                </article>
            </template>
        </div>
    </template>
</section>
