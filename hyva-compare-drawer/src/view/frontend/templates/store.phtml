<?php
declare(strict_types=1);

/** @var \Magento\Framework\Escaper $escaper */

$storageKey = 'scr1be_compare_v1';
$maxItems = 4;
?>
<script>
    'use strict';
    document.addEventListener('alpine:init', () => {
        const STORAGE_KEY = '<?= $escaper->escapeJs($storageKey) ?>';
        const MAX_ITEMS = <?= (int) $maxItems ?>;

        const readStorage = () => {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                return raw ? JSON.parse(raw) : [];
            } catch {
                return [];
            }
        };

        const writeStorage = (items) => {
            localStorage.setItem(STORAGE_KEY, JSON.stringify(items));
        };

        Alpine.store('compare', {
            items: readStorage(),
            minimized: false,
            max: MAX_ITEMS,

            init() {
                window.addEventListener('storage', (event) => {
                    if (event.key === STORAGE_KEY) {
                        this.items = event.newValue ? JSON.parse(event.newValue) : [];
                    }
                });
            },

            has(productId) {
                return this.items.some((item) => item.id === productId);
            },

            add(product) {
                if (this.has(product.id)) return;
                if (this.items.length >= this.max) {
                    this.items.shift();
                }
                this.items = [...this.items, product];
                writeStorage(this.items);
            },

            remove(productId) {
                this.items = this.items.filter((item) => item.id !== productId);
                writeStorage(this.items);
            },

            clear() {
                this.items = [];
                writeStorage(this.items);
            },

            reorder(fromIndex, toIndex) {
                const next = [...this.items];
                const [moved] = next.splice(fromIndex, 1);
                next.splice(toIndex, 0, moved);
                this.items = next;
                writeStorage(this.items);
            },

            get count() {
                return this.items.length;
            },

            get isVisible() {
                return this.items.length > 0;
            },
        });
    });
</script>
