{
    "name": "scr1be/product-families",
    "description": "Auto-derived product relationships — other colours, other sizes, similar — kept in three custom catalog_product_link types by a diff-based batch reconcile, rendered as swatch rows on the Hyva product page and exposed on ProductInterface in GraphQL",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-eav": "^102.1",
        "magento/module-store": "^101.1",
        "magento/module-config": "^101.2",
        "magento/module-backend": "^102.0",
        "magento/module-cron": "^100.4",
        "magento/module-swatches": "^100.4",
        "magento/module-graph-ql": "^100.4",
        "magento/module-catalog-graph-ql": "^100.4",
        "magento/module-related-product-graph-ql": "^100.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\ProductFamilies\\": ""
        }
    }
}
