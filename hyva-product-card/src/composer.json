{
    "name": "scr1be/hyva-product-card",
    "description": "One product card, four renderers — server phtml, Alpine client grid, widget and GraphQL — all reading the same ViewModel layer",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0",
        "magento/module-catalog": "^104.0",
        "magento/module-catalog-inventory": "^100.4",
        "magento/module-catalog-graph-ql": "^100.4",
        "magento/module-checkout": "^100.4",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-theme": "^101.1",
        "magento/module-widget": "^101.2",
        "hyva-themes/magento2-theme-module": "^1.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\HyvaProductCard\\": ""
        }
    }
}
