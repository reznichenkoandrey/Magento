<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Both plugins hang off the interface rather than Magento\Checkout\CustomerData\ItemPool,
        because the interface is what etc/frontend/di.xml in Magento_Checkout declares the
        preference for, and what the per-product-type renderers in the pool are typed against. One
        declaration therefore reaches every minicart item, including ones added by third parties.

        `after` in both cases: each plugin appends keys to a finished array. There is no decision to
        veto (which would want `before`) and nothing whose execution is conditional (which would
        want `around`) — an `around` here would add exactly one capability, the capability to break
        the minicart by forgetting to call $proceed.
    -->
    <type name="Magento\Checkout\CustomerData\ItemPoolInterface">
        <plugin name="scr1be_product_card_minicart_discount"
                type="Scr1be\HyvaProductCard\Plugin\Checkout\MinicartDiscount"
                sortOrder="10"/>
        <plugin name="scr1be_product_card_minicart_qty_rules"
                type="Scr1be\HyvaProductCard\Plugin\Checkout\MinicartQtyRules"
                sortOrder="20"/>
    </type>

    <!--
        Frontend-scoped so that nothing in the admin, in cron or in the CLI can lose its session to
        a path match. `after` follows core's own two implementations of this hook
        (Magento\GraphQl\Plugin\DisableSession, Magento\Paypal\Plugin\TransparentSessionChecker):
        the check is a conjunction of vetoes, so a running `false` is never turned back into `true`.
    -->
    <type name="Magento\Framework\Session\SessionStartChecker">
        <plugin name="scr1be_product_card_suppress_stock_endpoint_session"
                type="Scr1be\HyvaProductCard\Plugin\Session\SuppressStockEndpointSession"/>
    </type>
</config>
