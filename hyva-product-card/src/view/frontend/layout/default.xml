<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <!--
        The card block itself is declared by Hyvä in the `catalog_list_item` handle, which Hyvä
        includes from the pages that have listings (category, search, compare, its product slider)
        and — when Page Builder is installed — from `default`. A widget can be dropped anywhere, so
        the handle is pulled in globally here; layout merging makes a second include a no-op on the
        pages that already had it.

        The *scripts* are not pulled in with it. They live in `scr1be_product_card_scripts`, which
        only the listing handles include — see that file for why the two are separated.
    -->
    <update handle="catalog_list_item"/>
</page>
