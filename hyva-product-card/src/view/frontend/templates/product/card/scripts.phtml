<?php
declare(strict_types=1);

use Magento\Framework\Escaper;
use Scr1be\HyvaProductCard\Block\CardScripts;

/** @var CardScripts $block */
/** @var Escaper $escaper */

/**
 * Two tags: the endpoint config, and the entry module that reads it.
 *
 * The import map that used to sit above them is gone. `card-register.js` imports `./card.js` and
 * `./card-grid.js` relatively, so nothing on this page ever resolved a bare specifier through that
 * map — while its mere presence, as the second of three maps the storefront printed, was enough to
 * make Firefox reject the third and leave the slider unbooted.
 *
 * Nothing inline is emitted, so there is no `HyvaCsp::registerInlineScript()` call: `application/json`
 * is a media type no engine executes and needs no CSP treatment, and the module script is external.
 */

if (!$block->isEnabled()) {
    return;
}
?>
<script type="application/json" data-scr1be-card-config>
<?= /* @noEscape */ $block->getCardConfigJson() ?>
</script>
<script type="module" src="<?= $escaper->escapeUrl($block->getEntryScriptUrl()) ?>"></script>
