# PHPStan for the Scr1be modules.
#
# The repo has no CI-installed dependencies of its own: these are Magento modules, and
# they only resolve against a Magento installation. This config therefore expects the
# repo to sit inside one, as it does on the demo stand — `Magento/` is a subdirectory of
# the Magento root, so `..` is that root. Run it from this directory:
#
#   ../vendor/bin/phpstan analyse -c phpstan.neon --memory-limit 3G
#
# Level 5 is a deliberate choice, not a default. Below it the argument-type checks that
# found the `catch (\Throwable)` / `\Exception` parameter mismatches go away, and those
# are the findings that justify running the tool at all. Above it, Magento's own
# docblocks generate more noise than the modules do signal.
parameters:
    level: 5

    paths:
        - admin-grid-toolkit/src
        - back-in-stock/src
        - category-cascade/src
        - content-as-code/src
        - curated-categories/src
        - customer-group-guard/src
        - fpc-inspector/src
        - fraud-guard/src
        - headless-api-suite/src
        - hyva-compare-drawer/src
        - hyva-graphql-search/src
        - hyva-lazy-images/src
        - hyva-media/src
        - hyva-mega-menu/src
        - hyva-product-card/src
        - hyva-product-slider/src
        - hyva-quick-view/src
        - pos-bridge/src
        - product-families/src
        - signed-document-delivery/src
        - store-toolkit/src
        - tier-price-label/src

    # Generated interceptors and extension-attribute interfaces live here. Without them
    # the GraphQL resolver context appears not to have its extension attributes at all.
    # This directory is a build artifact: `setup:di:compile` creates it, and switching
    # deploy mode wipes it.
    scanDirectories:
        - ../generated/code

    bootstrapFiles:
        - ../vendor/autoload.php
        # Magento ships a PHPStan extension that teaches it DataObject's magic getters.
        # Without it every `$item->getSku()` on a DataObject is reported as undefined.
        - ../dev/tests/static/framework/Magento/PhpStan/autoload.php

    ignoreErrors:
        # `__()` returns Magento\Framework\Phrase, which has __toString(). The core
        # methods that "expect string" here declare no native type and are passed __()
        # results by core's own controllers — verified in ManagerInterface (no type hint
        # on $message) and in Magento\Catalog\Controller. The docblock is the
        # inaccuracy, so this would otherwise fire on every translated message we write.
        - '#expects string(\|null)?, Magento\\Framework\\Phrase given#'

        # `AdapterInterface::fetchOne()` is documented `@return string` and declares no native
        # type. What it actually runs is `Zend_Db_Adapter_Abstract::fetchOne()`, which returns
        # `$stmt->fetchColumn(0)` — and `PDOStatement::fetchColumn()` answers `false` when there
        # is no row, `null` when the column itself is NULL. Every guard this hides is therefore
        # correct, and the docblock is the thing that is wrong. Without this, the honest way to
        # write a "no row" check is reported as dead code.
        -
            message: '#Result of \|\| is always false\.#'
            path: '*/src/**/ResourceModel/*.php'
        -
            message: '#Result of && is always true\.#'
            path: 'product-families/src/Setup/Patch/Data/InstallFamilyLinkTypes.php'

        # `Magento\CatalogInventory\Model\Stock\Status::getQty()` is `return $this->getData(...)`
        # on an AbstractExtensibleModel, with `@return int` and no native type. `getData()` answers
        # null for a key that was never set, which is precisely the case the guard exists for: a
        # status row with no qty is a product nobody tracks, not a product with none left.
        -
            message: '#Else branch is unreachable because ternary operator condition is always true\.#'
            path: 'hyva-product-card/src/Controller/Stock/Status.php'

        # `Category::getLevel()` returns `getData(self::KEY_LEVEL)` when the key is set — the raw
        # column, which arrives from the database as a string. `@return int` describes the intent,
        # not the value.
        -
            message: '#Result of && is always true\.#'
            path: 'category-cascade/src/Model/CascadeGuard.php'

        # `AbstractSource::getOptionText()` is documented `string|bool`, but the source almost every
        # select attribute actually uses — `Eav\Model\Entity\Attribute\Source\Table` — declares
        # `@return array|string|bool` and returns an array for a multi-value option. Casting that to
        # string is the bug the guard prevents.
        -
            message: '#Else branch is unreachable because ternary operator condition is always true\.#'
            path: 'product-families/src/ViewModel/ProductFamilies.php'

        # Both of these are collateral from the bootstrap above, and worth understanding before
        # touching either.
        #
        # `Magento/PhpStan/autoload.php` registers a `GeneratedClassesAutoloader` carrying a
        # `FactoryGenerator`. That generator answers for *any* class whose name ends in `Factory`,
        # handing PHPStan a synthetic stub with the standard `create(array $data = [])` signature.
        # For the hundreds of factories Magento really does generate that is exactly right, and it
        # is what makes `CollectionFactory::create()` resolve to the correct collection subclass.
        #
        # For the handful of classes that end in `Factory` and are *hand-written*, it is wrong: the
        # stub shadows the real class, so `ResultFactory`'s constants vanish and `FileFactory`'s
        # five-parameter signature becomes a one-parameter one. Both classes were read in
        # `vendor/` — `ResultFactory` declares TYPE_PAGE, TYPE_REDIRECT and TYPE_FORWARD at lines
        # 22-27, and `FileFactory::create()` takes filename, content, baseDir, contentType and
        # contentLength. The calls are correct; the stub is not.
        #
        # Dropping the bootstrap instead would trade these eleven for a larger set: generated
        # extension-attribute interfaces stop resolving, and every `*CollectionFactory::create()`
        # loses its return type. Measured both ways before choosing.
        - '#Access to undefined constant Magento\\Framework\\Controller\\ResultFactory::TYPE_[A-Z]+\.#'
        - '#Magento\\Framework\\App\\Response\\Http\\FileFactory::create\(\)#'

        # `CookieMetadataFactory` is hand-written too, and loses its real methods to the same
        # generated stub.
        - '#Magento\\Framework\\Stdlib\\Cookie\\CookieMetadataFactory::create[A-Za-z]*CookieMetadata\(\)#'

        # The DataObject reflection extension registered below teaches PHPStan the magic getters,
        # and in doing so gives `setData`/`unsetData` a nullary signature. The real ones on
        # `Magento\Framework\DataObject` take a key and a value.
        - '#Magento\\Backend\\Model\\Session(\\Quote)?::(un)?setData\(\) invoked with [0-9]+ parameters?#'

        # A constructor asks for an interface, the container hands back the concrete class, and the
        # call is to a method only the concrete class declares. Verified as DI preferences rather
        # than assumed — each of these is a `<preference>` in core's own di.xml:
        #
        #   Magento\Store\Api\Data\StoreInterface       -> Magento\Store\Model\Store
        #   Magento\Catalog\Api\Data\ProductInterface   -> Magento\Catalog\Model\Product
        #   Magento\Framework\App\RequestInterface      -> Magento\Framework\App\Request\Http
        #
        # PHPStan resolves the interface, which is the honest thing for it to do; the guarantee
        # lives in the container and nowhere a static analyser can read it. Both directions appear:
        # calling a concrete-only method, and passing the interface where a helper wants the class.
        - '#Magento\\Store\\Api\\Data\\StoreInterface::(getBaseUrl|getCurrentCurrencyCode)\(\)#'
        - '#Magento\\Catalog\\Api\\Data\\ProductInterface::(getFinalPrice|getWebsiteIds|getProductUrl)\(\)#'
        - '#Magento\\Framework\\App\\RequestInterface::(getPostValue|getFullActionName)\(\)#'
        - '#expects int\|Magento\\Catalog\\Model\\Product, Magento\\Catalog\\Api\\Data\\ProductInterface given#'
        - '#expects Magento\\Catalog\\Model\\Product, Magento\\Catalog\\Api\\Data\\ProductInterface given#'
        -
            message: '#should return array<Magento\\Catalog\\Model\\Product> but returns array<int<0, max>, Magento\\Catalog\\Api\\Data\\ProductInterface>#'
            path: 'product-families/src/Model/ProductLink/FamilyCollectionProvider.php'

        # Extension attributes are generated by `setup:di:compile`, so the methods they add exist
        # at runtime and in `generated/`, but not on the interface PHPStan reads. CLAUDE.md already
        # records this for the unit suite; it is the same mechanism.
        - '#Magento\\Framework\\GraphQl\\Query\\Resolver\\ContextInterface::(getExtensionAttributes|getUserId)\(\)#'
        - '#Magento\\GraphQl\\Model\\Query\\ContextExtensionInterface::(getIsCustomer|getStore)\(\)#'
        - '#Magento\\Catalog\\Api\\Data\\ProductTierPriceExtensionInterface::(getWebsiteId|getPercentageValue)\(\)#'

        # Same `fetchOne()` reading as above; the comparison is reported per-operand as well as on
        # the `||` that joins them.
        - '#Strict comparison using === between string and (false|null) will always evaluate to false\.#'

        # `getCustomerId()` and friends are documented `int` on models that answer `getData()`, so
        # null is reachable and the guard is load-bearing. Same shape as `Stock\Status::getQty()`.
        - '#Strict comparison using === between (int|Magento\\Customer\\Api\\Data\\CustomerInterface) and .+ will always evaluate to false\.#'

        # Consequences of two suppressions above rather than findings of their own: once PHPStan
        # believes the guard is dead, it also believes the fallback behind it is unreachable and
        # the constant it uses is unused.
        -
            message: '#(Unreachable statement - code above always terminates\.|Constant Scr1be\\CategoryCascade\\Model\\CascadeGuard::PATH_SEPARATOR is unused\.)#'
            path: 'category-cascade/src/Model/CascadeGuard.php'
        -
            message: '#never returns null so it can be removed from the return type#'
            path: 'hyva-product-card/src/Controller/Stock/Status.php'

        # `__()` again, reaching a typed property this time instead of a parameter.
        - '#\$_addButtonLabel \(string\) does not accept Magento\\Framework\\Phrase#'

        # More core docblocks that are narrower than what core itself does. Each was checked by
        # reading the signature (none of them declares a native type) and, where the doubt was
        # real, by finding core passing the same "wrong" thing:
        #
        #   addAttributeToFilter  @param array $condition   -- core passes Status::STATUS_ENABLED
        #   insertLogo/Address    @param string|null $store -- the value reaches ScopeConfig, which
        #                                                      resolves a Store object perfectly well
        #   CustomerRegistry      @param string $customerId -- retrieveSecureData documents the very
        #                                                      same id as int, two methods below
        #   fetchCol              @param Select $sql        -- select() is declared on the Zend
        #                                                      adapter, so its own return type is
        #                                                      the one PHPStan reports as wrong
        - '#addAttributeToFilter\(\) expects array\|(string\|)?null, int given#'
        - '#Magento\\Sales\\Model\\Order\\Pdf\\AbstractPdf::insert(Logo|Address)\(\) expects string\|null, Magento\\Store\\Model\\Store given#'
        - '#Magento\\Customer\\Model\\CustomerRegistry::retrieve\(\) expects string, int given#'
        - '#AdapterInterface::fetchCol\(\) expects Magento\\Framework\\DB\\Select\|string, Zend_Db_Select given#'
        - '#Magento\\Widget\\Model\\Widget\\Instance::setStoreIds\(\) expects string, array<int> given#'
        - '#Magento\\Framework\\Data\\Collection::addFilter\(\) expects string, array#'
        - '#Magento\\Framework\\App\\ActionFlag::set\(\) expects string, true given#'

        # A repository handing its own model to its own resource. The model extends AbstractModel
        # and implements the interface; the constructor asks for the interface, so PHPStan sees
        # only that half.
        - '#Magento\\Framework\\Model\\ResourceModel\\Db\\AbstractDb::(save|delete)\(\) expects Magento\\Framework\\Model\\AbstractModel, Scr1be\\[A-Za-z]+\\Api\\Data\\[A-Za-z]+Interface given#'

services:
    -
        class: Magento\PhpStan\Reflection\Php\DataObjectClassReflectionExtension
        tags: {phpstan.broker.methodsClassReflectionExtension: {priority: 100}}

# The baseline is down to what is left in the test suites: mock properties typed as the class
# rather than `Foo&MockObject`, and a few fixtures whose shape is looser than the signature they
# are handed to. Shipped code is at zero.
#
# Everything that came out of it was either fixed or explained above. Nothing was dropped in
# silence, and the baseline is not a place to put a finding nobody wants to read.
includes:
    - phpstan-baseline.neon
