# PHPStan for the Scr1be modules.
#
# These are Magento modules: they only resolve against a Magento installation, so this config
# expects the repo to sit inside one, as it does on the demo stand — `Magento/` is a subdirectory
# of the Magento root, which makes `..` that root.
#
# The binary, though, is deliberately NOT the installation's. Magento 2.4.8 pins
# `phpstan/phpstan: ^1.9` in its own composer.json and `rector` holds it at `^1.12.5`, so
# requiring 2.x there would drag the stand's dev dependencies along with it for no benefit to
# the stand. `tools/phpstan/` is a two-line composer project that exists only to supply one:
#
#   composer install -d tools/phpstan          # once
#   tools/phpstan/vendor/bin/phpstan analyse -c phpstan.neon --memory-limit 3G
#
# The analysis still bootstraps `../vendor/autoload.php`, so every Magento class resolves from
# the installation exactly as before. Only the analyser is separate.
#
# Level 5 is a deliberate choice, not a default. Below it the argument-type checks that
# found the `catch (\Throwable)` / `\Exception` parameter mismatches go away, and those
# are the findings that justify running the tool at all. Above it, Magento's own
# docblocks generate more noise than the modules do signal.
#
# There is no baseline. Every finding the tool reports has been read: the ones that were real
# were fixed, and the ones that were not are the `ignoreErrors` entries below, each carrying the
# reading — usually a signature or a `<preference>` out of `vendor/` — that justifies it. A
# suppression nobody can check is worse than a red gate.
#
# Suppressions are keyed on `identifier:` wherever a whole class of finding is justified, and on
# message text only where the text is the distinguishing part. That is the main practical gain of
# 2.x here: the 1.x config matched English message strings, and six of those patterns silently
# stopped matching the moment the analyser reworded anything.
#
# Two things went with the 1.x binary, and both were on balance a gain:
#   - Magento's `DataObjectClassReflectionExtension` — it reaches into
#     `PHPStan\DependencyInjection\Container` for an internal class, which PHPStan's own upgrade
#     guide says cannot survive a major bump. Its job is now a coarser ignore rule, noted below.
#   - the `FactoryGenerator` bootstrap that came in the same file, which used to hand PHPStan a
#     synthetic stub for every hand-written class ending in `Factory`. Four ignore patterns existed
#     purely to undo that damage; all four are gone.
parameters:
    level: 5

    paths:
        - admin-grid-toolkit/src
        - back-in-stock/src
        - category-cascade/src
        - content-as-code/src
        - curated-categories/src
        - customer-group-guard/src
        - fpc-inspector/src
        - fraud-guard/src
        - headless-api-suite/src
        - hyva-compare-drawer/src
        - hyva-graphql-search/src
        - hyva-lazy-images/src
        - hyva-media/src
        - hyva-mega-menu/src
        - hyva-product-card/src
        - hyva-product-slider/src
        - hyva-quick-view/src
        - pos-bridge/src
        - product-families/src
        - signed-document-delivery/src
        - store-toolkit/src
        - tier-price-label/src

    # Generated interceptors and extension-attribute interfaces live here. Without them
    # the GraphQL resolver context appears not to have its extension attributes at all.
    # This directory is a build artifact: `setup:di:compile` creates it, and switching
    # deploy mode wipes it.
    scanDirectories:
        - ../generated/code

    bootstrapFiles:
        - ../vendor/autoload.php
        # The runner's own autoloader, for the extension registered at the bottom of this file.
        - tools/phpstan/vendor/autoload.php

    ignoreErrors:
        # `__()` returns Magento\Framework\Phrase, which has __toString(). The core methods that
        # "expect string" here declare no native type and are passed __() results by core's own
        # controllers — verified in ManagerInterface (no type hint on $message) and in
        # Magento\Catalog\Controller. The docblock is the inaccuracy.
        - '#expects string(\|null)?, Magento\\Framework\\Phrase given#'
        - '#\$_addButtonLabel \(string\) does not accept Magento\\Framework\\Phrase#'

        # `@SuppressWarnings(PHPMD.UnusedFormalParameter)` and friends. phpdoc-parser v2 refuses
        # the unquoted value, and this is the form Magento core itself writes — 433 occurrences of
        # CouplingBetweenObjects alone in `vendor/magento/framework` and `module-catalog`. Quoting
        # it here would make this repo the odd one out against the standard it is written to.
        -
            identifier: phpDoc.parseError
            message: '#@SuppressWarnings has invalid value#'

        # DataObject's magic accessors are handled by the extension registered at the bottom of
        # this file, not suppressed. What is left here is the other half of the same story: a
        # collection's `getItems()` is documented `DataObject[]`, so the objects are typed as the
        # bag rather than as what the collection actually holds. The extension answers the
        # accessors on them; it cannot change what the collection promises.
        -
            identifier: return.type
            message: '#returns (list<)?Magento\\Framework\\DataObject#'
        -
            identifier: argument.type
            message: '#, array<Magento\\Framework\\DataObject> given#'

        # A constructor asks for an interface, the container hands back the concrete class, and the
        # call is to a method only the concrete class declares. Verified as `<preference>` entries
        # in core's own di.xml rather than assumed:
        #
        #   Magento\Store\Api\Data\StoreInterface       -> Magento\Store\Model\Store
        #   Magento\Catalog\Api\Data\ProductInterface   -> Magento\Catalog\Model\Product
        #   Magento\Framework\App\RequestInterface      -> Magento\Framework\App\Request\Http
        #
        # PHPStan resolves the interface, which is the honest thing for it to do; the guarantee
        # lives in the container, where no static analyser can read it.
        -
            identifier: method.notFound
            message: '#Magento\\(Store\\Api\\Data\\StoreInterface|Catalog\\Api\\Data\\Product(TierPrice)?(Extension)?Interface|Framework\\App\\RequestInterface|Framework\\Controller\\ResultInterface|Framework\\View\\Element\\BlockInterface|Framework\\View\\Result\\Page|GraphQl\\Model\\Query\\ContextExtensionInterface|Framework\\GraphQl\\Query\\Resolver\\ContextInterface)::#'
        -
            identifier: method.notFound
            message: '#Magento\\(Catalog\\Model\\ResourceModel\\Product\\Collection|Eav\\Model\\Entity\\Attribute\\AbstractAttribute)::#'
        - '#expects int\|Magento\\Catalog\\Model\\Product, Magento\\Catalog\\Api\\Data\\ProductInterface given#'
        - '#expects Magento\\Catalog\\Model\\Product, Magento\\Catalog\\Api\\Data\\ProductInterface given#'
        - '#returns list<Magento\\Catalog\\Api\\Data\\ProductInterface>#'

        # Type guards on arrays that arrive from di.xml. A `@param array<FooInterface>` is a
        # promise the container never checks: `<argument xsi:type="array">` will inject whatever a
        # merchant's module puts there, and this guard is the only thing between that and a fatal
        # deep inside a loop. PHPStan believes the docblock, which is exactly why the guard reads
        # as redundant to it and is not.
        - identifier: instanceof.alwaysTrue

        # Guards against values whose declared type is optimistic: `fetchOne()` answers false or
        # null against a `@return string`, and every `getData()`-backed getter answers null for a
        # key that was never set while its docblock promises int or string. Both were read in
        # `vendor/` — Zend_Db_Adapter_Abstract::fetchOne() returns `$stmt->fetchColumn(0)`, and
        # `Stock\Status::getQty()` is a bare `getData()` call.
        - identifier: notIdentical.alwaysTrue
        - identifier: identical.alwaysFalse
        - identifier: function.alreadyNarrowedType
        - identifier: booleanAnd.alwaysTrue
        - identifier: booleanOr.alwaysFalse
        - identifier: deadCode.unreachable
        - identifier: classConstant.unused
        # Once the guard above is believed redundant, so is the nullable half of the return type
        # it exists to produce.
        - identifier: return.unusedType

        # More core docblocks narrower than what core itself does. Each was checked by reading the
        # signature — none declares a native type — and, where the doubt was real, by finding core
        # passing the same "wrong" thing: `addAttributeToFilter('status', Status::STATUS_ENABLED)`
        # against `@param array $condition` is the clearest.
        - '#add(Attribute|Field)ToFilter\(\) expects array\|(string\|)?null, int#'
        - '#addStoreFilter\(\) expects bool\|int\|Magento\\Store\\Model\\Store\|string\|null, Magento\\Store\\Api\\Data\\StoreInterface given#'
        - '#Magento\\Sales\\Model\\Order\\Pdf\\AbstractPdf::insert(Logo|Address)\(\) expects string\|null, Magento\\Store\\Model\\Store given#'
        - '#Magento\\Customer\\Model\\CustomerRegistry::retrieve\(\) expects string, int given#'
        - '#AdapterInterface::fetchCol\(\) expects Magento\\Framework\\DB\\Select\|string, Zend_Db_Select given#'
        - '#Magento\\Framework\\Data\\Collection::addFilter\(\) expects string, array#'
        # `@method Instance setStoreIds(string $value)` contradicts the model it is written on:
        # `Instance::beforeSave()` opens with `is_array($this->getData('store_ids'))` and implodes
        # it, and `getStoreIds()` explodes the column back into an array. Core expects the array
        # form and says otherwise in the annotation. Note this one is only visible *because* the
        # extension defers to `@method` — under a blanket DataObject suppression it never appeared.
        -
            message: '#Magento\\Widget\\Model\\Widget\\Instance::setStoreIds\(\) expects string, array<int> given#'
            path: 'content-as-code/src/ContentTransfer/Model/Widget/InstanceCodec.php'
        - '#Magento\\Framework\\App\\ActionFlag::set\(\) expects string, true given#'
        - '#Magento\\Framework\\Model\\ResourceModel\\Db\\AbstractDb::(save|delete)\(\) expects Magento\\Framework\\Model\\AbstractModel, Scr1be\\[A-Za-z]+\\Api\\Data\\[A-Za-z]+Interface given#'

        # The test suites, and one shape that runs through most of them: a unit test's job here is
        # frequently to hand a method something its signature forbids and prove the method copes —
        # `SourcePool` must reject a `stdClass`, `LinkPlanner` must normalise ids that arrived as
        # strings. Replacing those arguments with well-typed ones deletes what the test is for.
        -
            identifier: argument.type
            path: '*/Test/*'
        -
            identifier: method.notFound
            path: '*/Test/*'
        -
            identifier: return.type
            path: '*/Test/*'

services:
    -
        class: Scr1be\PHPStan\Reflection\MagicDataAccessorExtension
        tags:
            - phpstan.broker.methodsClassReflectionExtension
