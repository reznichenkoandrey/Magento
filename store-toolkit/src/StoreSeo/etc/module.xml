<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Scr1be_StoreSeo">
        <sequence>
            <module name="Magento_Store"/>
            <module name="Magento_Config"/>
            <module name="Magento_Backend"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Cms"/>
            <module name="Magento_UrlRewrite"/>
            <!--
              The alternate URL for a store is read out of the url_rewrite table, keyed by the
              entity_type strings these two modules own (ProductUrlRewriteGenerator::ENTITY_TYPE,
              CategoryUrlRewriteGenerator::ENTITY_TYPE, CmsPageUrlRewriteGenerator::ENTITY_TYPE).
            -->
            <module name="Magento_CatalogUrlRewrite"/>
            <module name="Magento_CmsUrlRewrite"/>
            <!--
              The robots cache invalidator purges the identity Magento\Robots\Block\Data emits
              (Magento\Robots\Model\Config\Value::CACHE_TAG . '_' . storeId), so the module that
              owns that constant has to be loaded first.
            -->
            <module name="Magento_Robots"/>
        </sequence>
    </module>
</config>
