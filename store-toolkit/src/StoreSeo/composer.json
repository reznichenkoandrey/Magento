{
    "name": "scr1be/store-toolkit-seo",
    "description": "The SEO third of the store toolkit - a memoised canonical that survives faceted query strings, entity-aware hreflang with a documented x-default ladder, and per-website robots.txt published to disk on config save",
    "type": "magento2-module",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "magento/framework": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-config": "^101.2",
        "magento/module-backend": "^102.0",
        "magento/module-catalog": "^104.0",
        "magento/module-cms": "^104.0",
        "magento/module-url-rewrite": "^102.0",
        "magento/module-catalog-url-rewrite": "^100.4",
        "magento/module-cms-url-rewrite": "^100.4",
        "magento/module-robots": "^101.1",
        "magento/module-directory": "^100.4"
    },
    "autoload": {
        "files": ["registration.php"],
        "psr-4": {
            "Scr1be\\StoreSeo\\": ""
        }
    }
}
