<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <!--
                              This section can stop a store taking money. It gets a resource of its
                              own so it can be granted to the people who are allowed to make that
                              call and withheld from everyone else who edits configuration.
                            -->
                            <resource id="Scr1be_StoreClosure::config"
                                      title="Store Toolkit: Closure"
                                      translate="title"
                                      sortOrder="210"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
