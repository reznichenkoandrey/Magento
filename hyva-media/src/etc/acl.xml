<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <!--
                          The chain down to Magento_Config::config is re-declared exactly as core
                          nests it — admin → stores → stores_settings → config
                          (module-config/etc/acl.xml). These ancestors carry no title on purpose:
                          they already have one where core declares them, and repeating it here
                          would be a second definition of somebody else's node.

                          The nesting is not cosmetic. Acl merges every module's tree into one
                          document validated against acl.xsd, whose uniqueResourceId constraint
                          allows an id to appear once. Hanging config off `stores` instead of
                          `stores_settings` puts the same id in two different branches, and the
                          merged document then fails validation with "Duplicate key-sequence
                          ['Magento_Config::config']" — which aborts Acl construction for the whole
                          installation, so every admin page dies while the storefront stays healthy.
                        -->
                        <resource id="Magento_Config::config">
                            <!--
                              Its own resource because these fields are a resource budget, not a
                              preference: the width ladder multiplies disk, the megapixel ceiling and the
                              per-request encode cap are the only things standing between an uploaded
                              40 MP TIFF-sized JPEG and a worker that never returns. A role that may edit
                              store copy should not be able to raise them.
                            -->
                            <resource id="Scr1be_HyvaMedia::config"
                                      title="Media Derivatives Section"
                                      translate="title"
                                      sortOrder="140"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
