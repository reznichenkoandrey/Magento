<?php
declare(strict_types=1);

use Scr1be\HyvaLazyImages\ViewModel\LazyImage;

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */

$src      = (string) $block->getData('src');
$alt      = (string) $block->getData('alt');
$width    = (int) $block->getData('width');
$height   = (int) $block->getData('height');
$sizes    = (string) ($block->getData('sizes') ?: '100vw');
$priority = (string) $block->getData('priority');

if ($src === '') {
    return;
}

/**
 * A ViewModel is not a Block. createBlock() runs the result through BlockFactory, which throws
 * a LogicException for anything that is not a BlockInterface — and LazyImage implements
 * ArgumentInterface, so that fallback fataled on every call that did not pass view_model.
 * ObjectManager is the correct resolver for a ViewModel; the layout-XML usage below stays the
 * documented path, and this only covers a block created at runtime without arguments.
 *
 * @var LazyImage $viewModel
 */
$viewModel = $block->getData('view_model')
    ?: \Magento\Framework\App\ObjectManager::getInstance()->get(LazyImage::class);

$image = $viewModel->generate($src, $sizes);

$isPriority = $priority === 'high';
$loading    = $isPriority ? 'eager' : 'lazy';
$decoding   = $isPriority ? 'sync' : 'async';
$fetchAttr  = $isPriority ? ' fetchpriority="high"' : '';

$srcsetAttr   = $isPriority ? 'srcset' : 'data-srcset';
$srcAttribute = $isPriority ? 'src' : 'data-src';
$initialSrc   = $isPriority
    ? $escaper->escapeUrl(strtok($image['jpg_srcset'], ' '))
    : $escaper->escapeUrl($image['lqip']);
?>
<?php // Alpine's @load instead of an inline onload= attribute: inline attribute handlers need
      // CSP3 unsafe-hashes, a strictly worse ask than the inline <script> blocks the sibling
      // modules register hashes for. Alpine is already on the page in Hyvä. ?>
<picture x-data class="scr1be-lazy-picture block">
    <source type="image/avif"
            <?= $srcsetAttr ?>="<?= $escaper->escapeHtmlAttr($image['avif_srcset']) ?>"
            sizes="<?= $escaper->escapeHtmlAttr($image['sizes']) ?>"/>
    <source type="image/webp"
            <?= $srcsetAttr ?>="<?= $escaper->escapeHtmlAttr($image['webp_srcset']) ?>"
            sizes="<?= $escaper->escapeHtmlAttr($image['sizes']) ?>"/>
    <img <?= $srcAttribute ?>="<?= $initialSrc ?>"
         <?php if (!$isPriority): ?>
             src="<?= $escaper->escapeUrl($image['lqip']) ?>"
             data-srcset-jpg="<?= $escaper->escapeHtmlAttr($image['jpg_srcset']) ?>"
         <?php else: ?>
             srcset="<?= $escaper->escapeHtmlAttr($image['jpg_srcset']) ?>"
         <?php endif; ?>
         sizes="<?= $escaper->escapeHtmlAttr($image['sizes']) ?>"
         alt="<?= $escaper->escapeHtmlAttr($alt) ?>"
         width="<?= $width ?: 'auto' ?>"
         height="<?= $height ?: 'auto' ?>"
         loading="<?= $loading ?>"
         decoding="<?= $decoding ?>"<?= $fetchAttr ?>
         class="block w-full h-auto bg-gray-100 transition-[filter] duration-300 motion-reduce:transition-none"
         style="<?= $isPriority ? '' : 'filter: blur(8px);' ?>"
         @load="$el.style.filter = 'none'"/>
</picture>
